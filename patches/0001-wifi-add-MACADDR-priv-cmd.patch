+/* Android wpa_supplicant queries the STA factory MAC via the
+ * "MACADDR" private command and expects a reply of the form
+ * "MACADDR = xx:xx:xx:xx:xx:xx".  MTK gen4m did not implement it,
+ * which makes framework getMacAddress() fail and fall back to a
+ * bogus default.  Provide it here.
+ */
+static int priv_driver_get_macaddr(IN struct net_device *prNetDev,
+	IN char *pcCommand, IN int i4TotalLen)
+{
+	struct GLUE_INFO *prGlueInfo = NULL;
+	uint8_t *pucMacAddr = NULL;
+	static const uint8_t aucZeroMac[] = NULL_MAC_ADDR;
+
+	if (GLUE_CHK_PR2(prNetDev, pcCommand) == FALSE)
+		return -1;
+
+	prGlueInfo = *((struct GLUE_INFO **) netdev_priv(prNetDev));
+	if (prGlueInfo && prGlueInfo->prAdapter) {
+		/* Prefer the permanent (NVRAM/efuse) STA MAC */
+		pucMacAddr = prGlueInfo->prAdapter->rWifiVar.aucPermanentAddress;
+		if (EQUAL_MAC_ADDR(aucZeroMac, pucMacAddr))
+			pucMacAddr =
+				prGlueInfo->prAdapter->rWifiVar.aucMacAddress;
+	}
+	if (!pucMacAddr || EQUAL_MAC_ADDR(aucZeroMac, pucMacAddr))
+		pucMacAddr = prNetDev->dev_addr;
+
+	return kalSnprintf(pcCommand, i4TotalLen,
+		"MACADDR = %02x:%02x:%02x:%02x:%02x:%02x",
+		pucMacAddr[0], pucMacAddr[1], pucMacAddr[2],
+		pucMacAddr[3], pucMacAddr[4], pucMacAddr[5]);
+}
