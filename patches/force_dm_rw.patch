--- a/block/genhd.c
+++ b/block/genhd.c
@@ -1469,6 +1469,15 @@ static void set_disk_ro_uevent(struct gendisk *gd, int ro)
 
 void set_device_ro(struct block_device *bdev, int flag)
 {
+	/* Force-rw: same as set_disk_ro(), userspace BLKROSET must not be
+	 * able to lock down a device-mapper device.
+	 */
+	if (bdev && bdev->bd_disk &&
+	    bdev->bd_disk->disk_name[0] == 'd' &&
+	    bdev->bd_disk->disk_name[1] == 'm' &&
+	    bdev->bd_disk->disk_name[2] == '-')
+		flag = 0;
+
 	bdev->bd_part->policy = flag;
 }
 
@@ -1479,6 +1488,15 @@ void set_disk_ro(struct gendisk *disk, int flag)
 	struct disk_part_iter piter;
 	struct hd_struct *part;
 
+	/*
+	 * Force-rw: never let device-mapper devices be marked read-only so
+	 * that mappable/verity volumes can be remounted rw for debugging.
+	 * This catches every path that would otherwise set the dm disk ro.
+	 */
+	if (disk->disk_name[0] == 'd' && disk->disk_name[1] == 'm' &&
+	    disk->disk_name[2] == '-')
+		flag = 0;
+
 	if (disk->part0.policy != flag) {
 		set_disk_ro_uevent(disk, flag);
 		disk->part0.policy = flag;
