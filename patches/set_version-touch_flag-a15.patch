 #if WAKEUP_GESTURE
 	if (bTouchIsAwake == 0) {
 		pm_wakeup_event(&ts->input_dev->dev, 5000);
@@ -1803,6 +1918,13 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 	}
 #endif
 
+	touch_flag = 1;
+	ret = nvt_touch_flag_proc_init();
+	if (ret != 0) {
+		NVT_ERR("nvt touch flag proc init failed. ret=%d\n", ret);
+		goto err_touch_flag_proc_init_failed;
+	}
+
 #if NVT_LOCKDOWN
 	ret = nvt_proc_tp_lockdown_info();
 	if (ret != 0) {
@@ -1881,6 +2003,8 @@ static int32_t nvt_ts_probe(struct spi_device *client)
 nvt_mp_proc_deinit();
 err_mp_proc_init_failed:
 #endif
+nvt_touch_flag_proc_deinit();
+err_touch_flag_proc_init_failed:
 #if NVT_TOUCH_EXT_PROC
 nvt_extra_proc_deinit();
 err_extra_proc_init_failed:
@@ -1974,6 +2098,7 @@ static int32_t nvt_ts_remove(struct spi_device *client)
 #if NVT_TOUCH_MP
 	nvt_mp_proc_deinit();
 #endif
+	nvt_touch_flag_proc_deinit();
 #if NVT_TOUCH_EXT_PROC
 	nvt_extra_proc_deinit();
 #endif
@@ -2050,6 +2175,7 @@ static void nvt_ts_shutdown(struct spi_device *client)
 #if NVT_TOUCH_MP
 	nvt_mp_proc_deinit();
 #endif
+	nvt_touch_flag_proc_deinit();
 #if NVT_TOUCH_EXT_PROC
 	nvt_extra_proc_deinit();
 #endif
@@ -2216,7 +2342,8 @@ static int32_t nvt_ts_resume(struct device *dev)
 	}
 
 #if !WAKEUP_GESTURE
-	nvt_irq_enable(true);
+	if (touch_flag)
+		nvt_irq_enable(true);
 #endif
 
