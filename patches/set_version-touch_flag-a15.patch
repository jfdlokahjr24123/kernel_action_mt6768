 #define GESTURE_WORD_W          13
@@ -1309,6 +1421,9 @@ static irqreturn_t nvt_ts_work_func(int irq, void *data)
 	int32_t i = 0;
 	int32_t finger_cnt = 0;
 
+	if (touch_flag == 0)
