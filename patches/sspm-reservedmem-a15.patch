diff --git a/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c b/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
index d9a6986e6..b1ba99ce4 100644
--- a/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
+++ b/drivers/misc/mediatek/sspm/sspm_ipi_mbox.c
@@ -715,6 +715,18 @@ int sspm_ipi_send_sync(int mid, int opts, void *buffer, int slot,
 	if (sspm_ipi_inited == 0)
 		return IPI_SERVICE_NOT_INITED;
 
+	/*
+	 * sspm_ipi_inited is set as soon as the mbox HW is initialized, which
+	 * happens before sspm_reserve_memory_init(). If the reserved memory
+	 * lookup fails (e.g. sspm_mem_base_phys == 0), the SSPM share region
+	 * was never remapped and any IPI sent from an early initcall (such as
+	 * mt_freqhopping_drv_init) dereferences a bogus mbox address and
+	 * panics. Mirror the v4.14 behaviour and refuse to send until the
+	 * whole SSPM driver probe has completed successfully.
+	 */
+	if (!is_sspm_ready())
+		return IPI_SERVICE_NOT_INITED;
+
 	/* check if mid is in the predefined range */
 	if ((mid < 0) || (mid >= TOTAL_SEND_PIN))
 		return IPI_SERVICE_NOT_AVAILABLE;
diff --git a/drivers/misc/mediatek/sspm/v1/sspm_helper.c b/drivers/misc/mediatek/sspm/v1/sspm_helper.c
index 3070069d6..6c9a244d7 100644
--- a/drivers/misc/mediatek/sspm/v1/sspm_helper.c
+++ b/drivers/misc/mediatek/sspm/v1/sspm_helper.c
@@ -204,7 +204,11 @@ static int sspm_device_probe(struct platform_device *pdev)
 #ifdef CONFIG_OF_RESERVED_MEM
 	if (sspm_reserve_memory_init(sspm_pdev)) {
 		pr_err("[SSPM] Reserved Memory Failed\n");
-		atomic_set(&sspm_inited, 1);
+		/*
+		 * Leave sspm_ready == 0: the share region is unusable, so any
+		 * IPI must be refused (see is_sspm_ready() check added to
+		 * sspm_ipi_send_sync()) instead of dereferencing a bad mbox.
+		 */
 		return -1;
 	}
 #endif
@@ -215,6 +219,9 @@ static int sspm_device_probe(struct platform_device *pdev)
 		}
 	}
 
+	/* Everything is up: allow IPI senders to proceed. */
+	sspm_ready = 1;
+
 	return 0;
 }
 
@@ -264,10 +271,16 @@ static int __init sspm_init(void)
 		pr_err("[SSPM] Device Init Failed\n");
 		goto error;
 	}
-	pr_debug("[SSPM] Helper Init\n");
 
-	sspm_ready = 1;
+	pr_debug("[SSPM] Helper Init\n");
 
+	/*
+	 * NOTE: do NOT mark the service ready here. sspm_ready is set by
+	 * sspm_device_probe() only after the reserved memory has been
+	 * validated. Otherwise an early IPI sender (e.g.
+	 * mt_freqhopping_drv_init) would bypass is_sspm_ready() and touch an
+	 * unmapped mbox when sspm_reserve_memory_init() failed.
+	 */
 	atomic_set(&sspm_inited, 1);
 	return 0;
 
